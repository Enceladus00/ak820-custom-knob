{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AK820 MAX Ultra Toolbox",
  "version": "1.3.0",
  "identifier": "io.github.enceladus00.ak820-custom-knob",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AK820 MAX Ultra Toolbox",
        "width": 1000,
        "height": 700,
        "minWidth": 780,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
